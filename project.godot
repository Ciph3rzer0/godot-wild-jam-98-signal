config_version=5

[application]

config/name="godot-wild-jam-98-signal"
run/main_scene="uid://bjopuuaqydblu"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DebugDraw="*res://addons/debug_draw/debug_draw_3d.tscn"
Profily="*uid://qmnu1ehm866e"

[debug]

shapes/navigation/3d/geometry_face_color=Color(0.91764706, 0.9411765, 0.5058824, 1)

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/log/plugin.cfg", "res://addons/profily/plugin.cfg", "res://addons/reload_current_scene/plugin.cfg")

[global_group]

